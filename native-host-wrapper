#!/bin/zsh

set -euo pipefail

runtime_dir=${0:A:h}
for node_bin in "$HOME/.local/bin/node" /opt/homebrew/bin/node /usr/local/bin/node; do
  if [[ -x "$node_bin" ]]; then
    exec "$node_bin" "$runtime_dir/native-host.mjs" \
      --config "$runtime_dir/config.json"
  fi
done

print -u2 -- "remote FIDO native host requires Node.js in ~/.local/bin or Homebrew"
exit 127
