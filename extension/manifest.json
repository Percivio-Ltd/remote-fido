{
  "manifest_version": 3,
  "name": "LYTiQ Remote FIDO",
  "version": "0.2.1",
  "description": "Forwards Chrome WebAuthn assertions to one operator-controlled FIDO key over Tailscale.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webAuthenticationProxy"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Connect remote FIDO"
  }
}
